# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets. This is loaded automatically on startup
# (see the top of app.js); if .env doesn't exist, the app falls back to
# whatever's already in the real environment (e.g. set by pm2 in prod).

# Turn-notification push (see README.md > "Push notifications" for how to
# generate these). Leaving these unset is fine for casual local testing --
# the app auto-generates a temporary keypair instead -- but subscriptions
# won't survive a restart until real values are set here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@davincischallenge.app

# Shared secret required (as an X-Admin-Token header) to hit the /listgames
# and /history/* debug endpoints in app.js. Leave unset to disable those
# routes entirely.
ADMIN_TOKEN=
